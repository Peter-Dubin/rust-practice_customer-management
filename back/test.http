### Global variables
@baseUrl = http://localhost:8001

# =============================================================================
# CUSTOMERS
# =============================================================================

### List all customers (no filters)
GET {{baseUrl}}/customers

### List customers with pagination
GET {{baseUrl}}/customers?page=2&per_page=5

### List customers filtered by company name
GET {{baseUrl}}/customers?name_filter=Zajazd

### List customers sorted by company name descending
GET {{baseUrl}}/customers?order_by=CompanyName&order_direction=DESC

### List customers — combined filters (page, size, search, sort)
GET {{baseUrl}}/customers?page=1&per_page=5&name_filter=a&order_by=CompanyName&order_direction=ASC

### Get a specific customer by ID
GET {{baseUrl}}/customers/ALFKI

### Get a customer that does not exist (expects 404)
GET {{baseUrl}}/customers/DOESNOTEXIST

### Create a new customer
POST {{baseUrl}}/customers
Content-Type: application/json

{
    "customer_id": "DEMO1",
    "company_name": "Demo Company",
    "contact_name": "John Doe",
    "contact_title": "CEO",
    "address": "123 Main St",
    "city": "Demo City",
    "region": "Demo Region",
    "postal_code": "12345",
    "country": "Demo Country",
    "phone": "123-456-7890",
    "fax": "098-765-4321"
}

### Update an existing customer
PUT {{baseUrl}}/customers/DEMO1
Content-Type: application/json

{
    "company_name": "Updated Company Name",
    "contact_name": "Jane Doe",
    "contact_title": "CTO",
    "address": "456 Other St",
    "city": "Other City",
    "region": "Other Region",
    "postal_code": "54321",
    "country": "Other Country",
    "phone": "098-765-4321",
    "fax": "123-456-7890"
}

### Delete a customer
DELETE {{baseUrl}}/customers/DEMO1


# =============================================================================
# SUPPLIERS
# =============================================================================

### List all suppliers (no filters)
GET {{baseUrl}}/suppliers

### List suppliers with pagination
GET {{baseUrl}}/suppliers?page=1&per_page=5

### List suppliers filtered by company name
GET {{baseUrl}}/suppliers?name_filter=Tokyo

### List suppliers sorted by company name ascending
GET {{baseUrl}}/suppliers?order_by=CompanyName&order_direction=ASC

### List suppliers — combined filters (page, size, search, sort)
GET {{baseUrl}}/suppliers?page=1&per_page=5&name_filter=e&order_by=CompanyName&order_direction=ASC

### Get a specific supplier by ID
GET {{baseUrl}}/suppliers/1

### Get a supplier that does not exist (expects 404)
GET {{baseUrl}}/suppliers/99999

### Create a new supplier (supplier_id is auto-generated)
POST {{baseUrl}}/suppliers
Content-Type: application/json

{
    "company_name": "Demo Supplier Co.",
    "contact_name": "Alice Smith",
    "contact_title": "Sales Manager",
    "address": "789 Trade Blvd",
    "city": "Chicago",
    "region": "IL",
    "postal_code": "60601",
    "country": "USA",
    "phone": "312-555-0100",
    "fax": "312-555-0101",
    "home_page": "https://demosupplier.example.com"
}

### Update an existing supplier (use the ID returned from the POST above)
PUT {{baseUrl}}/suppliers/30
Content-Type: application/json

{
    "company_name": "Updated Supplier Co.",
    "contact_name": "Bob Johnson",
    "contact_title": "Account Director",
    "address": "101 Commerce St",
    "city": "New York",
    "region": "NY",
    "postal_code": "10001",
    "country": "USA",
    "phone": "212-555-0200",
    "fax": "212-555-0201",
    "home_page": "https://updatedsupplier.example.com"
}

### Delete a supplier
DELETE {{baseUrl}}/suppliers/30
